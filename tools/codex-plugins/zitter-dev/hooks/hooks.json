{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/guard.py\"",
            "commandWindows": "python3 \"${PLUGIN_ROOT}/hooks/guard.py\"",
            "timeout": 5,
            "statusMessage": "Checking Zitter build command"
          }
        ]
      }
    ]
  }
}
