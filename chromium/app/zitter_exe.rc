// zitter.exe's version: Explorer, Apps & features and the installer read it.
// Only the version lives here; every icon must stay in chrome_dll.rc, whose
// icon image IDs a second .rc would collide with.
#include <winres.h>

#include "chromium/app/zitter_version.h"

#if defined(ZITTER_DEV_BUILD)
#define ZITTER_PRODUCT_NAME "Zitter Dev"
#else
#define ZITTER_PRODUCT_NAME "Zitter"
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION ZITTER_VERSION
 PRODUCTVERSION ZITTER_VERSION
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Zitter contributors"
      VALUE "FileDescription", ZITTER_PRODUCT_NAME
      VALUE "FileVersion", ZITTER_VERSION_STRING
      VALUE "InternalName", "zitter"
      VALUE "LegalCopyright", "Copyright 2026 Zitter contributors"
      VALUE "OriginalFilename", "zitter.exe"
      VALUE "ProductName", ZITTER_PRODUCT_NAME
      VALUE "ProductVersion", ZITTER_VERSION_STRING
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
