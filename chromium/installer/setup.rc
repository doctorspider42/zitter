// zitter_setup.exe: its icon, version, manifest and the design's fonts.
#include <winres.h>

#include "chromium/app/zitter_version.h"
#include "chromium/installer/setup_resource.h"

#if defined(ZITTER_DEV_BUILD)
#define ZITTER_PRODUCT_NAME "Zitter Dev"
#define ZITTER_SETUP_NAME "Zitter Dev Setup"
#else
#define ZITTER_PRODUCT_NAME "Zitter"
#define ZITTER_SETUP_NAME "Zitter Setup"
#endif

IDI_SETUP ICON "../app/zitter.ico"

IDR_FONT_SERIF RCDATA "../../assets/fonts/InstrumentSerif-Regular.ttf"
IDR_FONT_SERIF_ITALIC RCDATA "../../assets/fonts/InstrumentSerif-Italic.ttf"
IDR_FONT_SANS RCDATA "../../assets/fonts/SchibstedGrotesk-Variable.ttf"
IDR_FONT_SANS_ITALIC RCDATA "../../assets/fonts/SchibstedGrotesk-Italic-Variable.ttf"
IDR_FONT_MONO RCDATA "../../assets/fonts/JetBrainsMono-Variable.ttf"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION ZITTER_VERSION
 PRODUCTVERSION ZITTER_VERSION
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Zitter contributors"
      VALUE "FileDescription", ZITTER_SETUP_NAME
      VALUE "FileVersion", ZITTER_VERSION_STRING
      VALUE "InternalName", "zitter_setup"
      VALUE "LegalCopyright", "Copyright 2026 Zitter contributors"
      VALUE "OriginalFilename", "zitter_setup.exe"
      VALUE "ProductName", ZITTER_PRODUCT_NAME
      VALUE "ProductVersion", ZITTER_VERSION_STRING
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
