# Installed at //zitter/BUILD.gn in a Chromium src checkout.
import("//testing/test.gni")
import("//build/rust/rust_static_library.gni")
import("chromium/assistant/assistant_runtime.gni")
import("chromium/prototype/workspace_presentation.gni")

zitter_workspace_presentation("workspace_presentation") {
}

if (is_win) {
  import("chromium/app/windows_channel.gni")
}

zitter_assistant_runtime("zitter_assistant") {
}

executable("assistant_cli_fixture") {
  testonly = true
  sources = [ "tests/fixtures/assistant_cli.cc" ]
  deps = [ "//base" ]
}

if (is_mac) {
  action("ui_lab_shader") {
    script = "chromium/app/compile_ui_lab_metal.py"
    sources = [ "chromium/app/ui_lab.metal" ]
    outputs = [ "$target_gen_dir/chromium/app/ui_lab_shader.h" ]
    args = [ rebase_path(sources[0], root_build_dir), rebase_path(outputs[0], root_build_dir) ]
  }
  rust_static_library("ui_lab_scene") {
    crate_root = "chromium/app/ui_lab_scene.rs"
    sources = [ crate_root ]
    cxx_bindings = [ crate_root ]
    allow_unsafe = true
    build_native_rust_unit_tests = true
  }
  source_set("ui_lab") {
    sources = [
      "chromium/app/ui_lab.h",
      "chromium/app/ui_lab.cc",
      "chromium/app/ui_lab_metal.h",
      "chromium/app/ui_lab_metal.mm",
    ]
    include_dirs = [ ".", target_gen_dir ]
    deps = [ ":shell", ":ui_lab_scene", ":ui_lab_shader" ]
    frameworks = [ "Metal.framework", "QuartzCore.framework", "AppKit.framework" ]
  }
}

# Keep the upstream browser_tests hook, but build just Zitter's probe locally.
test("zitter_prototype") {
  testonly = true
  # Verify native behavior with the same LTO backend level as the regular app.
  configs -= [ "//build/config/compiler:thinlto_optimize_default" ]
  configs += [ "//build/config/compiler:thinlto_optimize_max" ]
  deps = [
    ":profile_workspace_browser_tests",
    "//chrome:packed_resources",
    "//chrome:resources",
    "//chrome:strings",
    "//chrome/test:test_support",
    "//chrome/test:test_support_ui",
    "//chrome/test/base:browser_tests_runner",
  ]
  data = [ "testdata/" ]
  if (is_mac) {
    data_deps = [
      ":assistant_runtime",
      ":night_shift_runtime",
      "//chrome",
      "//chrome:chrome_framework",
    ]
  } else {
    data_deps = [ "//chrome:packed_resources", ":assistant_runtime", ":night_shift_runtime" ]
  }
}

