if (is_win) {
  import("//build/config/win/manifest.gni")

  windows_manifest("setup_manifest") {
    sources = [ "chromium/installer/setup.manifest" ]
  }

  executable("setup_runtime_tests") {
    testonly = true
    sources = [ "chromium/installer/setup_runtime.cc", "chromium/installer/setup_runtime_test.cc" ]
    include_dirs = [ "." ]
    libs = [ "ole32.lib", "oleaut32.lib", "shell32.lib", "user32.lib" ]
  }

  # Zitter's installer and uninstaller (design: Instalator): a standalone
  # Direct2D window with the design's fonts and no Chromium code.
  # tools/package_win.py appends the app to it.
  executable("zitter_setup") {
    sources = [
      "chromium/installer/setup.rc",
      "chromium/installer/setup_accessibility.cc",
      "chromium/installer/setup_accessibility.h",
      "chromium/installer/setup_install.cc",
      "chromium/installer/setup_install.h",
      "chromium/installer/setup_main.cc",
      "chromium/installer/setup_runtime.cc",
      "chromium/installer/setup_runtime.h",
      "chromium/installer/setup_resource.h",
      "chromium/installer/setup_text.h",
    ]
    include_dirs = [ "." ]
    configs -= [ "//build/config/win:console" ]
    configs += [ "//build/config/win:windowed" ]
    deps = [ ":setup_manifest", "//third_party/zlib:minizip" ]
    libs = [ "d2d1.lib", "dwmapi.lib", "dwrite.lib", "ole32.lib", "oleaut32.lib", "propsys.lib", "shell32.lib", "advapi32.lib", "uiautomationcore.lib" ]
  }
}
# Real browser bootstrap, with no browser-test runner or test-only dependencies.
if (is_mac || is_linux || is_win) {
  executable("zitter") {
    # Match Chromium's main browser link: ThinLTO defaults to LTO O0 even
    # when thin_lto_enable_optimizations is true, unless opted in per target.
    configs -= [ "//build/config/compiler:thinlto_optimize_default" ]
    configs += [ "//build/config/compiler:thinlto_optimize_max" ]
    sources = [
      "chromium/app/main.cc",
      "chromium/app/browser_client.cc",
      "chromium/app/browser_client.h",
      "chromium/app/runtime.cc",
      "chromium/app/performance_probe.cc",
      "chromium/app/performance_probe.h",
      "chromium/app/runtime.h",
      "//chrome/app/chrome_main_delegate.cc",
      "//chrome/app/chrome_main_delegate.h",
      "//chrome/app/startup_timestamps.h",
    ]
    include_dirs = [ "." ]
    deps = [
      ":shell",
      ":network_policy",
      "//base",
      "//build:chromeos_buildflags",
      "//chrome:dependencies",
      "//chrome/app:command_ids",
      "//chrome/browser:chrome_content_browser_client",
      "//chrome/browser:chrome_browser_main",
      "//chrome/browser:chrome_process_singleton",
      "//chrome/browser:process_singleton",
      "//chrome/browser:startup_data",
      "//chrome/browser:main_extra_parts",
      "//chrome/browser/lifetime",
      "//chrome/browser/ui/browser_window",
      "//chrome/common:version_header",
      "//chrome/common/profiler",
      "//components/keep_alive_registry",
      "//components/webapps/isolated_web_apps:scheme",
      "//components/memory_system",
      "//content/public/app",
      "//services/network/public/mojom",
      "//ui/lottie",
    ]
    data_deps = [ "//chrome:packed_resources", ":assistant_runtime" ]
    if (is_posix) {
      # On Windows, chrome_elf holds the crash reporter client.
      sources += [
        "//chrome/app/chrome_crash_reporter_client.cc",
        "//chrome/app/chrome_crash_reporter_client.h",
      ]
      deps += [ "//chrome/app:chrome_crash_reporter_client" ]
    }
    if (is_mac) {
      deps += [ ":ui_lab" ]
      sources += [
        "chromium/app/app_shell_mac.h",
        "chromium/app/app_shell_mac.mm",
        "//chrome/app/chrome_crash_reporter_client_mac.mm",
        "//chrome/app/chrome_main_mac.h",
        "//chrome/app/chrome_main_mac.mm",
      ]
      deps += [
        "//chrome/browser:chrome_browser_application_mac",
        "//chrome/browser/mac",
      ]
      data_deps += [ "//chrome:chrome_framework" ]
      ldflags = [ "-Wl,-ObjC" ]
    }
    if (is_linux) {
      sources += [ "//chrome/app/chrome_main_linux.cc", "//chrome/app/chrome_main_linux.h" ]
    }
    if (is_win) {
      # chrome.dll's dependencies, linked into the one executable; chrome_elf
      # stays a DLL, loaded first, as chrome.exe loads it. chrome.dll's icon
      # resource carries Zitter's icon (tools/install_chromium_overlay.py).
      configs -= [ "//build/config/win:console" ]
      configs += [ "//build/config/win:windowed", "//build/config/win:delayloads" ]
      sources += [ "chromium/app/zitter_exe.rc" ]
      libs = [ "shell32.lib" ]
      deps += [
        ":updater",
        "//build/win:default_exe_manifest",
        "//chrome/app/theme:chrome_unscaled_resources",
        "//chrome/browser/win/isolated_browser:isolated_browser_support",
