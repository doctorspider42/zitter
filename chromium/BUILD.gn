    args = [ rebase_path(sources[0], root_build_dir), rebase_path(outputs[0], root_build_dir), "--namespace", "zitter::sidebar" ]
  }
  rust_static_library("ui_lab_scene") {
    crate_root = "chromium/app/ui_lab_scene.rs"
    sources = [ crate_root ]
    cxx_bindings = [ crate_root ]
    allow_unsafe = true
