# Installed at //zitter/BUILD.gn in a Chromium src checkout.
import("//testing/test.gni")
import("//build/rust/rust_static_library.gni")

# The Rust UI: scene, layout, controls and editor state. Portable on purpose.
rust_static_library("sidebar_scene") {
  crate_root = "chromium/prototype/sidebar_scene.rs"
  sources = [
    crate_root,
    "chromium/prototype/design.rs",
    "chromium/prototype/design_tokens.rs",
    "chromium/prototype/i18n.rs",
    "chromium/prototype/i18n_en_native.rs",
    "chromium/prototype/i18n_en_scene.rs",
    "chromium/prototype/i18n_en_shell.rs",
    "chromium/prototype/sidebar_editor.rs",
    "chromium/prototype/timeline.rs",
  ]
  cxx_bindings = [ crate_root ]
  allow_unsafe = true
  build_native_rust_unit_tests = true
}

# Built-in ad blocking (docs/ad-blocking.md): Brave's adblock-rust (MPL-2.0),
# vendored unmodified by tools/vendor_adblock.py, behind a small cxx bridge.
rust_static_library("content_blocking_engine") {
  crate_root = "chromium/prototype/adblock.rs"
  sources = [ crate_root ]
  # Zitter's scriptlets and redirect bodies, compiled in with include_str!.
  inputs = [
    "chromium/prototype/adblock_resources.js",
    "chromium/prototype/adblock_zitter_list.txt",
  ]
  cxx_bindings = [ crate_root ]
  allow_unsafe = true
  build_native_rust_unit_tests = true
  deps = [ "//third_party/rust/zitter_vendor:adblock" ]
}

if (is_mac) {
  action("ui_lab_shader") {
    script = "chromium/app/compile_ui_lab_metal.py"
    sources = [ "chromium/app/ui_lab.metal" ]
