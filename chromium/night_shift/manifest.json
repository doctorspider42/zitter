{
  "manifest_version": 3,
  "name": "Night Shift",
  "version": "1.0.0",
  "description": "Dynamic dark themes with per-site controls.",
  "key": "",
  "permissions": ["scripting", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "incognito": "not_allowed",
  "action": {
    "default_title": "Night Shift",
    "default_icon": {"16": "moon.png", "32": "moon.png"},
    "default_popup": "panel.html"
  },
  "options_ui": {"page": "settings.html", "open_in_tab": true},
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  }
}
