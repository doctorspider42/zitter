# Keep Debug in out/Zitter; compare with this component Release first.
# Non-component linking and LTO/PGO are separate later experiments.
is_debug = false
is_component_build = true
symbol_level = 0
blink_symbol_level = 0
v8_symbol_level = 0
target_cpu = "arm64"
use_remoteexec = false
use_siso = false

# Decode common MP4/MOV media (H.264/AAC and platform HEVC).
proprietary_codecs = true
ffmpeg_branding = "Chrome"
