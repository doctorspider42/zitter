  outputs = [ "$target_gen_dir/content_blocking_probe_script.h" ]
  args = [
    rebase_path(sources[0], root_build_dir),
    rebase_path(outputs[0], root_build_dir),
    "kContentBlockingProbeScript",
  ]
}

