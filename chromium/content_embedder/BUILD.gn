if (is_mac) {
  executable("mac_release_metadata_probe") {
    testonly = true
    include_dirs = [ "//zitter" ]
    sources = [
      "//zitter/chromium/app/mac_release_metadata.cc",
      "//zitter/chromium/app/mac_release_metadata.h",
      "//zitter/chromium/app/mac_release_metadata_probe.cc",
    ]
    deps = [
      "//base",
      "//crypto",
      "//url",
    ]
  }

  executable("verify_login_database") {
    testonly = true
    sources = [
      "cookie_encryption_mac.cc",
      "cookie_encryption_mac.h",
      "cookie_store_verifier.cc",
      "cookie_store_verifier.h",
      "verify_login_database_mac.cc",
    ]
    deps = [
      "//base",
      "//base:i18n",
      "//components/os_crypt/async/browser",
      "//components/os_crypt/async/browser:key_provider_interface",
      "//components/os_crypt/async/browser:keychain_key_provider",
      "//components/password_manager/core/browser/password_store:password_store_impl",
      "//components/password_manager/core/browser/sync",
      "//crypto",
      "//crypto:mock_apple_keychain",
      "//services/network/public/cpp",
      "//services/network/public/mojom",
      "//sql",
      "//url",
    ]
    if (icu_use_data_file) {
      data_deps = [ "//third_party/icu:icudata" ]
    }
    assert_no_deps = [
      "//chrome:*",
      "//chrome/*",
    ]
  }

  product = "Zitter Content Lab"
  framework = "$product Framework"
  helper = "$product Helper"
  launch_sources = [ "//content/shell/app/shell_main_mac.cc" ]
  launch_deps = [
    "//base:compiler_specific",
    "//base/allocator:early_zone_registration_apple",
    "//sandbox/mac:seatbelt",
  ]

  bundle_data("night_shift_resources") {
    sources = night_shift_files
    outputs = [ "{{bundle_resources_dir}}/night_shift/{{source_file_part}}" ]
  }

  bundle_data("night_shift_vendor_resources") {
    sources = night_shift_vendor
    outputs =
        [ "{{bundle_resources_dir}}/night_shift/vendor/{{source_file_part}}" ]
  }

  bundle_data("framework_resources") {
    sources = [
      "$root_out_dir/zitter_content.pak",
      "//ui/gl/resources/angle-metal/gpu_shader_cache.bin",
    ]
    public_deps = [ ":resources" ]
    if (icu_use_data_file) {
      sources += [ "$root_out_dir/icudtl.dat" ]
      public_deps += [ "//third_party/icu:icudata" ]
    }
    if (v8_use_external_startup_data) {
      if (use_v8_context_snapshot) {
        sources += [ "$root_out_dir/$v8_context_snapshot_filename" ]
        public_deps += [ "//tools/v8_context_snapshot" ]
      }
      if (!use_v8_context_snapshot || include_both_v8_snapshots) {
        sources += [ "$root_out_dir/snapshot_blob.bin" ]
        public_deps += [ "//v8:run_mksnapshot_default" ]
      }
    }
    outputs = [ "{{bundle_resources_dir}}/{{source_file_part}}" ]
  }

  bundle_data("framework_libraries") {
    sources = [
      "$root_out_dir/vk_intermediates/libvk_swiftshader.dylib",
      "$root_out_dir/vk_intermediates/vk_swiftshader_icd.json",
      "$root_out_dir/vulkan_intermediates/libvulkan.dylib",
    ]
    public_deps = [
      "//ui/gl:swiftshader_vk_library_copy",
      "//ui/gl:vulkan_loader_library_copy",
    ]
    if (!use_static_angle) {
      sources += [
        "$root_out_dir/egl_intermediates/libEGL.dylib",
        "$root_out_dir/egl_intermediates/libGLESv2.dylib",
      ]
      public_deps += [ "//ui/gl:angle_library_copy" ]
    }
    outputs = [ "{{bundle_contents_dir}}/Libraries/{{source_file_part}}" ]
  }

  foreach(kind,
          [
            "app",
            "framework",
            "helper",
          ]) {
    tweak_info_plist("${kind}_plist") {
      info_plist = "${kind}-Info.plist"
      args = [
        "--breakpad=0",
        "--keystone=0",
        "--scm=0",
        "--version",
        "0.1.0.0",
      ]
    }
  }

  helpers = content_mac_helpers + content_mac_aperitif_helpers
  foreach(params, helpers) {
    mac_app_bundle("helper_${params[0]}") {
      output_name = helper + params[2]
      info_plist_target = ":helper_plist"
      extra_substitutions = [ "HELPER_BUNDLE_ID_SUFFIX=${params[1]}" ]
      sources = launch_sources
      deps = launch_deps

      if (is_component_build) {
        # Seatbelt is loaded before main(), so the framework's rpath is not yet
        # available. From a bundled helper, walk back to the component output.
        ldflags =
            [ "-Wl,-rpath,@executable_path/../../../../../../../../../.." ]
      }
      defines = [
        "HELPER_EXECUTABLE",
        "SHELL_PRODUCT_NAME=\"$product\"",
      ]
    }
  }

  bundle_data("framework_helpers") {
    sources = []
    public_deps = []
    foreach(params, helpers) {
      sources += [ "$root_out_dir/$helper${params[2]}.app" ]
      public_deps += [ ":helper_${params[0]}" ]
    }
    outputs = [ "{{bundle_contents_dir}}/Helpers/{{source_file_part}}" ]
  }

  mac_framework_bundle("browser_framework") {
    output_name = framework
    framework_version = "A"
    framework_contents = [
      "Helpers",
      "Libraries",
      "Resources",
    ]
    info_plist_target = ":framework_plist"
    sources = lab_sources + [
                "//zitter/chromium/app/mac_release_metadata.cc",
                "//zitter/chromium/app/mac_release_metadata.h",
                "//zitter/chromium/app/network_policy.cc",
                "//zitter/chromium/app/network_policy.h",
                "//zitter/chromium/app/updater_mac.cc",
                "//zitter/chromium/app/updater_mac.h",
                "cookie_encryption_mac.cc",
                "cookie_encryption_mac.h",
                "download_file_actions_mac.mm",
                "embedder_mac.mm",
                "extension_notifications_mac.h",
                "extension_notifications_mac.mm",
                "native_message_process_host.cc",
                "native_message_process_host.h",
                "native_process_launcher.h",
                "password_authenticator_mac.h",
                "password_authenticator_mac.mm",
                "workspace_media_access_mac.mm",
                "workspace_native_message_port_dispatcher.cc",
                "workspace_native_message_port_dispatcher.h",
                "workspace_native_messaging_mac.cc",
                "workspace_native_messaging_mac.h",
              ]
    include_dirs = lab_includes
    if (enable_printing) {
      sources += [
        "system_print_mac.h",
        "system_print_mac.mm",
      ]
    }
    frameworks = [
      "AppKit.framework",
      "AVFoundation.framework",
      "LocalAuthentication.framework",
      "Security.framework",
      "UserNotifications.framework",
    ]
    if (enable_printing) {
      frameworks += [ "ApplicationServices.framework" ]
    }
    deps = lab_deps + [
             "//components/os_crypt/async/browser",
             "//components/os_crypt/async/browser:key_provider_interface",
             "//components/os_crypt/async/browser:keychain_key_provider",
             "//components/os_crypt/common:switches",
             "//components/services/quarantine",
             "//device/fido",
             "//services/network/public/mojom",
             "//sql",
             "//zitter:devtools_console",
           ]
    bundle_deps = [
      ":framework_helpers",
      ":framework_libraries",
      ":framework_resources",
      ":night_shift_resources",
      ":night_shift_vendor_resources",
    ]
    ldflags = [ "-Wl,-install_name,@rpath/$framework.framework/$framework" ]
    if (is_component_build) {
      ldflags += [ "-Wl,-rpath,@loader_path/../../../../../.." ]
    }
  }

  bundle_data("framework_bundle") {
    sources = [ "$root_out_dir/$framework.framework" ]
    outputs = [ "{{bundle_contents_dir}}/Frameworks/{{source_file_part}}" ]
    public_deps = [ ":browser_framework" ]
  }

  bundle_data("assistant_bundle") {
    sources = [ "$root_out_dir/zitter_assistant" ]
    outputs = [ "{{bundle_executable_dir}}/{{source_file_part}}" ]
    public_deps = [ "//zitter:zitter_assistant" ]
  }

  bundle_data("app_icon") {
    sources = [ "Zitter.icns" ]
    outputs = [ "{{bundle_resources_dir}}/{{source_file_part}}" ]
  }

  mac_app_bundle("lab_app") {
    output_name = product
    info_plist_target = ":app_plist"
    sources = launch_sources
    deps = launch_deps + [
             ":app_icon",
             ":assistant_bundle",
             ":framework_bundle",
           ]
    defines = [ "SHELL_PRODUCT_NAME=\"$product\"" ]
  }
} else {
  copy("night_shift_resources") {
    sources = night_shift_files
    outputs = [ "$root_out_dir/resources/night_shift/{{source_file_part}}" ]
  }

  copy("night_shift_vendor_resources") {
    sources = night_shift_vendor
    outputs =
        [ "$root_out_dir/resources/night_shift/vendor/{{source_file_part}}" ]
  }

  executable("lab_app_win") {
    output_name = "zitter_content"
    write_runtime_deps = "$root_out_dir/zitter_content.runtime_deps"
    sources = lab_sources + [
                "cookie_encryption_win.cc",
                "cookie_encryption_win.h",
                "download_file_actions_win.cc",
                "embedder_win.cc",
                "password_authenticator_win.cc",
                "password_authenticator_win.h",
              ]
    include_dirs = lab_includes
    deps = lab_deps + [
             "//build/win:default_exe_manifest",
             "//components/os_crypt/async/browser",
             "//components/os_crypt/async/browser:dpapi_key_provider",
             "//components/pref_registry",
             "//components/prefs",
             "//components/services/quarantine",
             "//content:sandbox_helper_win",
             "//sandbox",
             "//services/network/public/mojom",
             "//sql",
             "//ui/wm",
           ]
    data_deps = [
      ":night_shift_resources",
      ":night_shift_vendor_resources",
      ":resources",
      "//zitter:zitter_assistant",
    ]
    if (icu_use_data_file) {
      data_deps += [ "//third_party/icu:icudata" ]
    }
    if (v8_use_external_startup_data) {
      if (use_v8_context_snapshot) {
        data_deps += [ "//tools/v8_context_snapshot" ]
      }
      if (!use_v8_context_snapshot || include_both_v8_snapshots) {
        data_deps += [ "//v8:run_mksnapshot_default" ]
      }
    }
    configs -= [ "//build/config/win:console" ]
    configs += [
      "//build/config/win:delayloads",
      "//build/config/win:windowed",
    ]
    libs = [
      "advapi32.lib",
      "credui.lib",
      "ole32.lib",
      "secur32.lib",
      "shell32.lib",
      "user32.lib",
    ]
    ldflags = [ "/STACK:0x800000" ]
  }
}

group("zitter_content") {
  if (is_mac) {
    deps = [ ":lab_app" ]
  } else {
    deps = [ ":lab_app_win" ]
  }
  assert_no_deps = [
    "//chrome:*",
    "//chrome/*",
  ]
}

executable("import_extension_alarms") {
  sources = [ "import_extension_alarms.cc" ]
  deps = [
    "//base",
    "//extensions/common/api",
    "//third_party/leveldatabase",
  ]
}
